<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FeishuDocExport.Gui.ViewModels"
        xmlns:ctl="clr-namespace:FeishuDocExport.Gui.Views.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        x:Class="FeishuDocExport.Gui.Views.GuideWindow"
        x:DataType="vm:GuideViewModel"
        Title="使用引导"
        Width="940" Height="660"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Page}">

  <Window.Styles>
    <Style Selector="TextBlock.steptitle">
      <Setter Property="FontSize" Value="19" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>

    <Style Selector="TextBlock.row">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style Selector="Border.item">
      <Setter Property="Padding" Value="0,0,0,2" />
    </Style>

    <Style Selector="Border.item.note">
      <Setter Property="Background" Value="{DynamicResource Brush.Warn.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
      <Setter Property="Padding" Value="11,9" />
    </Style>

    <Style Selector="Border.bullet">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.line-item">
      <Setter Property="Background" Value="{DynamicResource Brush.Inset}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="TextBlock.line-item">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.dot">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.dot.done">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style Selector="Border.dot.on">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style Selector="TextBlock.dot">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>

    <Style Selector="TextBlock.dot.done">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <Style Selector="TextBlock.dot.on">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Text}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ===== 顶部：标题 + 序号圆点 ===== -->
    <Border Grid.Row="0"
            Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="3">
          <TextBlock Classes="steptitle" Text="使用引导" />
          <TextBlock Classes="hint"
                     Text="照着做完这几节，就能把整个知识库搬到本地。随时可以从主界面重新打开。" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    IsVisible="{Binding ShowNav}">
          <ItemsControl ItemsSource="{Binding Dots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GuideDot">
                <Border Classes="dot"
                        Classes.on="{Binding IsActive}"
                        Classes.done="{Binding IsDone}">
                  <TextBlock Classes="dot"
                             Classes.on="{Binding IsActive}"
                             Classes.done="{Binding IsDone}"
                             Text="{Binding Number}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== 中部：左文字步骤，右示意图 ===== -->
    <Grid Grid.Row="1" ColumnDefinitions="450,*" ColumnSpacing="18" Margin="20,16">

      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,8,0">
          <TextBlock Classes="steptitle" Text="{Binding Title}" />
          <TextBlock Classes="dim" Text="{Binding Summary}" />

          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="9" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GuideRow">
                <Border Classes="item" Classes.note="{Binding IsNote}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="hint"
                               Text="提示"
                               FontWeight="SemiBold"
                               Width="26"
                               Foreground="{DynamicResource Brush.Warn}"
                               VerticalAlignment="Top"
                               IsVisible="{Binding IsNote}" />
                    <Border Classes="bullet"
                            Width="5"
                            Margin="0,8,0,0"
                            IsVisible="{Binding IsBullet}"
                            VerticalAlignment="Top" />

                    <StackPanel Spacing="6" MaxWidth="360">
                      <TextBlock Classes="row" Text="{Binding Text}" />

                      <ItemsControl ItemsSource="{Binding Lines}"
                                    IsVisible="{Binding HasLines}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Classes="line-item">
                              <TextBlock Classes="line-item" Text="{Binding}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="-6,0,0,0">
                        <Button Classes="link"
                                Content="打开这个页面"
                                Command="{Binding OpenUrlCommand}"
                                CommandParameter="{Binding Url}"
                                IsVisible="{Binding HasUrl}" />
                        <Button Classes="link"
                                Content="复制名单"
                                Command="{Binding CopyCommand}"
                                CommandParameter="{Binding CopyText}"
                                IsVisible="{Binding HasCopy}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1"
              Classes="card"
              VerticalAlignment="Top">
        <StackPanel Spacing="8">
          <TextBlock Classes="hint" Text="示意图（非真实截图）" />
          <ctl:GuideArt Kind="{Binding Art}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ===== 底部：提示 + 翻页 ===== -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Card}"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            BorderThickness="0,1,0,0"
            Padding="20,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="hint"
                     Text="{Binding CopyHint}"
                     Foreground="{DynamicResource Brush.Ok}"
                     IsVisible="{Binding CopyHint, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="hint" Text="{Binding ProgressText}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost"
                  Content="跳过"
                  Command="{Binding SkipCommand}"
                  IsCancel="True"
                  IsVisible="{Binding ShowNav}" />
          <Button Classes="ghost"
                  Content="上一步"
                  Command="{Binding PrevCommand}"
                  IsEnabled="{Binding !IsFirst}"
                  IsVisible="{Binding ShowNav}" />
          <Button Classes="primary"
                  Content="{Binding NextLabel}"
                  Command="{Binding NextCommand}"
                  IsDefault="True"
                  MinWidth="104" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
