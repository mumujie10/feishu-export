<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    设计 token：界面里不允许出现硬编码色值，一律引用这里的键。
    浅色/深色两套同名键，控件通过 DynamicResource 自动跟随主题切换。
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">

      <Color x:Key="SystemAccentColor">#1A73E8</Color>

      <SolidColorBrush x:Key="Brush.Accent" Color="#1A73E8" />
      <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#1765CC" />
      <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#1358B8" />
      <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#E8F0FE" />
      <SolidColorBrush x:Key="Brush.Accent.Text" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Accent.OnSoft" Color="#174EA6" />

      <SolidColorBrush x:Key="Brush.Page" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Card" Color="#F8F9FA" />
      <SolidColorBrush x:Key="Brush.Raised" Color="#F1F3F4" />
      <SolidColorBrush x:Key="Brush.Inset" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Hover" Color="#00000008" />
      <SolidColorBrush x:Key="Brush.Pressed" Color="#00000010" />

      <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#E8EAED" />
      <SolidColorBrush x:Key="Brush.Border.Strong" Color="#DADCE0" />

      <SolidColorBrush x:Key="Brush.Text" Color="#202124" />
      <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#5F6368" />
      <SolidColorBrush x:Key="Brush.Text.Muted" Color="#80868B" />
      <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Brush.Ok" Color="#137333" />
      <SolidColorBrush x:Key="Brush.Ok.Soft" Color="#E6F4EA" />
      <SolidColorBrush x:Key="Brush.Warn" Color="#B05A00" />
      <SolidColorBrush x:Key="Brush.Warn.Soft" Color="#FEF7E0" />
      <SolidColorBrush x:Key="Brush.Err" Color="#B3261E" />
      <SolidColorBrush x:Key="Brush.Err.Soft" Color="#FDECEA" />
      <SolidColorBrush x:Key="Brush.Err.Border" Color="#F5C6C0" />

      <SolidColorBrush x:Key="Brush.Badge.Text" Color="#5F6368" />
      <SolidColorBrush x:Key="Brush.Badge.Border" Color="#DADCE0" />

    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">

      <Color x:Key="SystemAccentColor">#8AB4F8</Color>

      <SolidColorBrush x:Key="Brush.Accent" Color="#8AB4F8" />
      <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#A8C7FA" />
      <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#6B9BE8" />
      <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#22395B" />
      <SolidColorBrush x:Key="Brush.Accent.Text" Color="#121314" />
      <SolidColorBrush x:Key="Brush.Accent.OnSoft" Color="#A8C7FA" />

      <SolidColorBrush x:Key="Brush.Page" Color="#17181A" />
      <SolidColorBrush x:Key="Brush.Card" Color="#1F2123" />
      <SolidColorBrush x:Key="Brush.Raised" Color="#121314" />
      <SolidColorBrush x:Key="Brush.Inset" Color="#1B1D1F" />
      <SolidColorBrush x:Key="Brush.Hover" Color="#FFFFFF14" />
      <SolidColorBrush x:Key="Brush.Pressed" Color="#FFFFFF20" />

      <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#33363B" />
      <SolidColorBrush x:Key="Brush.Border.Strong" Color="#454950" />

      <SolidColorBrush x:Key="Brush.Text" Color="#E8EAED" />
      <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#9AA0A6" />
      <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7A7F87" />
      <SolidColorBrush x:Key="Brush.Text.Inverse" Color="#121314" />

      <SolidColorBrush x:Key="Brush.Ok" Color="#81C995" />
      <SolidColorBrush x:Key="Brush.Ok.Soft" Color="#17402B" />
      <SolidColorBrush x:Key="Brush.Warn" Color="#FDD663" />
      <SolidColorBrush x:Key="Brush.Warn.Soft" Color="#4A3F14" />
      <SolidColorBrush x:Key="Brush.Err" Color="#F28B82" />
      <SolidColorBrush x:Key="Brush.Err.Soft" Color="#4B2A28" />
      <SolidColorBrush x:Key="Brush.Err.Border" Color="#6E3B36" />

      <SolidColorBrush x:Key="Brush.Badge.Text" Color="#9AA0A6" />
      <SolidColorBrush x:Key="Brush.Badge.Border" Color="#454950" />

    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- 与主题无关的尺寸节奏 -->
  <CornerRadius x:Key="Radius.Card">10</CornerRadius>
  <CornerRadius x:Key="Radius.Control">7</CornerRadius>
  <CornerRadius x:Key="Radius.Chip">5</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <Thickness x:Key="Pad.Card">14,12</Thickness>
  <Thickness x:Key="Pad.Page">20,16</Thickness>
  <x:Double x:Key="Size.Section">13</x:Double>
  <x:Double x:Key="Size.Label">12</x:Double>
  <x:Double x:Key="Size.Hint">11</x:Double>
  <x:Double x:Key="Size.Body">13</x:Double>
  <x:Double x:Key="Size.Title">15</x:Double>
  <x:Double x:Key="Size.Metric">16</x:Double>

</ResourceDictionary>
